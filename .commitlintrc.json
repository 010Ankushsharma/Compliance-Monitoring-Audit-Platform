{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [2, "always", [
      "feat",     
      "fix",      
      "docs",     
      "style",    
      "refactor", 
      "perf",     
      "test",     
      "build",    
      "ci",       
      "chore",    
      "revert",   
      "security"  
    ]],
    "scope-enum": [2, "always", [
      "auth", "policy", "audit", "violation",
      "alert", "report", "dashboard", "kafka",
      "security", "config", "docker", "k8s", "ci", "deps"
    ]],
    "subject-max-length": [2, "always", 100],
    "body-max-line-length": [2, "always", 200]
  }
}
