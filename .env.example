# =============================================================
#  Compliance Monitoring & Audit Platform
#  .env.example — Copy to .env and fill in your values
#
#  Usage:
#    cp .env.example .env
#    # edit .env with real values
#    docker-compose up
#
#  NEVER commit .env to version control.
#  .env is already listed in .gitignore.
#
#  Sections:
#    1. Application
#    2. Database (PostgreSQL)
#    3. Cache (Redis)
#    4. Messaging (Kafka)
#    5. Security (JWT)
#    6. Email (SMTP)
#    7. Notifications (Slack / Webhook)
#    8. Reports
#    9. Observability
#   10. Rate Limiting & CORS
#   11. Docker / Infra
# =============================================================


# =============================================================
# 1. APPLICATION
# =============================================================

# Active Spring profile: dev | prod
# Default: dev
SPRING_PROFILES_ACTIVE=dev

# HTTP port the application listens on
SERVER_PORT=8080

# Management/Actuator port (keep internal — never expose publicly)
MANAGEMENT_PORT=8081

# Root log level: TRACE | DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO


# =============================================================
# 2. DATABASE — PostgreSQL 15
# =============================================================

# PostgreSQL hostname or IP
DB_HOST=localhost

# PostgreSQL port
DB_PORT=5432

# Database name (must exist before first startup — Flyway creates schema)
DB_NAME=compliance_db

# Database user (should have CREATE TABLE, INDEX, SEQUENCE privileges)
DB_USERNAME=compliance_user

# Database password — use a strong random value in production
DB_PASSWORD=change_me_in_production


# =============================================================
# 3. CACHE — Redis 7
# =============================================================

# Redis hostname or IP
REDIS_HOST=localhost

# Redis port
REDIS_PORT=6379

# Redis password (leave blank if AUTH is not configured — dev only)
REDIS_PASSWORD=


# =============================================================
# 4. MESSAGING — Apache Kafka
# =============================================================

# Comma-separated list of Kafka broker addresses
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# SASL credentials (required in production with SASL_SSL)
# Leave blank for local/dev without authentication
KAFKA_USERNAME=
KAFKA_PASSWORD=


# =============================================================
# 5. SECURITY — JWT
# =============================================================

# JWT signing secret — MUST be at least 256 bits (32 chars) in dev,
# at least 512 bits (64 chars) in production.
# Generate with: openssl rand -base64 64
# REQUIRED — app will not start without this value.
JWT_SECRET=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_256_BITS

# Access token time-to-live in milliseconds
# Default: 3600000 (1 hour)
JWT_EXPIRATION_MS=3600000

# Refresh token time-to-live in milliseconds
# Default: 604800000 (7 days)
JWT_REFRESH_EXPIRATION_MS=604800000


# =============================================================
# 6. EMAIL — SMTP
# =============================================================

# SMTP server hostname (e.g. smtp.sendgrid.net, email-smtp.us-east-1.amazonaws.com)
SMTP_HOST=localhost

# SMTP port — 587 for STARTTLS, 465 for SSL, 1025 for MailHog (dev)
SMTP_PORT=587

# SMTP authentication credentials
SMTP_USERNAME=
SMTP_PASSWORD=

# Sender address shown in notification emails
NOTIFICATION_FROM_EMAIL=noreply@yourcompany.com

# Enable/disable email notifications: true | false
EMAIL_NOTIFICATIONS_ENABLED=false


# =============================================================
# 7. NOTIFICATIONS — Slack & Webhook
# =============================================================

# Slack Incoming Webhook URL
# Create at: https://api.slack.com/messaging/webhooks
# Example: https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX
SLACK_WEBHOOK_URL=

# Enable/disable Slack notifications: true | false
SLACK_NOTIFICATIONS_ENABLED=false


# =============================================================
# 8. REPORTS
# =============================================================

# Filesystem path where generated PDF/Excel/CSV reports are stored
# The directory will be created if it does not exist.
# In production use a mounted persistent volume or S3-backed path.
REPORTS_STORAGE_PATH=/tmp/compliance-reports


# =============================================================
# 9. OBSERVABILITY
# =============================================================

# Fraction of requests to sample for distributed tracing (0.0 – 1.0)
# 1.0 = trace every request (dev), 0.05 = 5% (prod recommended)
TRACE_SAMPLING_PROBABILITY=1.0

# Zipkin / OTLP endpoint for trace export (leave blank to disable)
# Example: http://localhost:9411/api/v2/spans
ZIPKIN_ENDPOINT=


# =============================================================
# 10. RATE LIMITING & CORS
# =============================================================

# Enable API rate limiting: true | false
RATE_LIMIT_ENABLED=true

# Maximum sustained requests per minute per IP/token
RATE_LIMIT_RPM=60

# Short burst allowance (requests allowed in a 1-second window)
RATE_LIMIT_BURST=20

# Comma-separated list of allowed CORS origins
# Production example: https://app.yourcompany.com,https://admin.yourcompany.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Enable IP allowlist enforcement: true | false
# When true, only IPs in ALLOWED_IPS can reach the API
IP_ALLOWLIST_ENABLED=false

# Comma-separated list of allowed IP addresses / CIDR ranges
# Example: 10.0.0.0/8,203.0.113.42
ALLOWED_IPS=


# =============================================================
# 11. DOCKER / INFRA (used by docker-compose.yml)
# =============================================================

# PostgreSQL Docker image tag
POSTGRES_VERSION=15-alpine

# Redis Docker image tag
REDIS_VERSION=7-alpine

# Kafka image (Confluent Platform)
KAFKA_VERSION=7.5.0

# Zookeeper image
ZOOKEEPER_VERSION=7.5.0

# Kafka UI (Provectus) — dev convenience only
KAFKA_UI_VERSION=latest

# MailHog — local SMTP server for dev email testing
MAILHOG_VERSION=latest

# Prometheus
PROMETHEUS_VERSION=v2.52.0

# Grafana
GRAFANA_VERSION=10.4.2

# Application Docker image tag (used when pulling a pre-built image)
APP_IMAGE_TAG=1.0.0

# =============================================================
# END OF .env.example
# =============================================================
